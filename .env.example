# Copy to .env and edit as needed. Every value here has a working default --
# none of these are required to run the starter out of the box.
#
# Secrets (if you wire in a real connector) belong here, as environment
# variables, and nowhere else -- never in a committed config file.

# --- Server identity --------------------------------------------------------
MCP_CONNECT_SERVER_NAME=mcp-connect-starter

# --- Bundled demo data (zero external accounts) ----------------------------
# MCP_CONNECT_DB_PATH=./data/demo.sqlite3
# MCP_CONNECT_DOCS_DIR=./data/docs
# MCP_CONNECT_CRM_FIXTURE=./data/crm_mock.json

# --- Read-only SQL guard rails ----------------------------------------------
# MCP_CONNECT_SQL_MAX_ROWS=200
# MCP_CONNECT_SQL_TIMEOUT_S=5

# --- Least-privilege scopes / allowlist -------------------------------------
# Comma-separated scopes this server instance is granted. A tool only runs
# if every scope it requires (see config/scopes.yaml) is in this set.
# MCP_CONNECT_GRANTED_SCOPES=data:read,docs:read,crm:read

# Optional hard allowlist of tool names, independent of scopes.
# MCP_CONNECT_ALLOWED_TOOLS=sql_query,list_sql_tables,search_docs,read_doc

# Path to the scopes/policy file (see config/scopes.yaml).
# MCP_CONNECT_SCOPES_FILE=./config/scopes.yaml

# --- Audit logging -----------------------------------------------------------
# Optional: also append structured JSON audit records to this file
# (they are always written to stderr regardless).
# MCP_CONNECT_AUDIT_LOG_FILE=./audit.log

# --- HTTP transport ----------------------------------------------------------
# MCP_CONNECT_HTTP_HOST=127.0.0.1
# MCP_CONNECT_HTTP_PORT=8080
# MCP_CONNECT_HTTP_STATELESS=false

# --- Real connector credentials (only needed if you swap in a real adapter) -
# These are NOT read by the bundled mock adapter; they're here as the
# pattern to follow when you implement connectors/crm/base.CRMAdapter
# against a real system. See README "How to add your own connector".
# HUBSPOT_API_KEY=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# JIRA_BASE_URL=
# JIRA_API_TOKEN=
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
